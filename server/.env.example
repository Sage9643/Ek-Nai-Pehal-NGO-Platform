# Server
PORT=5000
NODE_ENV=development
LOG_LEVEL=info

# MongoDB Atlas
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/ek-nai-pehal?retryWrites=true&w=majority

# CORS — comma-separated frontend URLs
CLIENT_ORIGIN=http://localhost:5173,https://ek-nai-pehal-ngo-platform.vercel.app

# Google Gemini API (Free Tier)
GEMINI_API_KEY=your_gemini_api_key_here

# Admin Authentication (Phase 2 — optional until configured)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_HASH=your_bcrypt_hash_here
ADMIN_JWT_SECRET=your_jwt_secret_here
ADMIN_JWT_EXPIRES_IN=24h
